# Copy to .env and fill in. Nothing here is read from source code directly.
PORT=8080

# Any OpenAI-compatible chat endpoint.
#   Groq (default):  https://api.groq.com/openai/v1   openai/gpt-oss-120b
#   Ollama (local):  http://localhost:11434/v1        qwen2.5:3b   (no key; set
#                    LLM_REASONING_EFFORT= empty, it is not a reasoning model)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=2500
LLM_REASONING_EFFORT=low
# Set to a folder to cache LLM replies during eval runs (saves free-tier quota).
LLM_CACHE_DIR=

# auto picks cuda when it is available
DEVICE=auto
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small

CORPUS_DIR=corpus
INDEX_DIR=index

# Tuned on the dev split only. See docs/evaluation.md.
REFUSAL_THRESHOLD=0.05
NLI_ENTAIL_THRESHOLD=0.5
CONTEXT_PER_VERSION=3
CONTEXT_CHARS=1200
MAX_QUESTION_CHARS=1000
